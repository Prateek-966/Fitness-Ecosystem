{
  "name": "nutrition-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal nutrition log. Voice in, personal index, calibrated intake.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && TZ=Asia/Kolkata vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "load-indb": "tsx scripts/load-indb.ts",
    "import-healthify": "tsx scripts/import-healthify.ts",
    "nightly": "tsx scripts/nightly.ts",
    "diagnostics": "tsx scripts/diagnostics.ts",
    "test:browser": "vite build && node tests/browser/run.mjs",
    "test:all": "npm test && npm run test:browser",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.50.1-build1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.11"
  }
}
