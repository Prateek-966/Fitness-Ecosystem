# Mirrors the headers in render.yaml. Kept in step with it deliberately:
# the CSP here must stay byte-identical to the one the build injects as a
# <meta> tag, or the two enforce a surprising intersection.
#
# Every add_header lives in the server block and NOWHERE else. In nginx,
# an add_header inside a location REPLACES the entire inherited set rather
# than adding to it — so a per-location Cache-Control would silently drop
# the CSP and X-Frame-Options from exactly the HTML page that needs them
# most. Cache-Control is varied through a map instead.

map $uri $app_cache_control {
    # Everything is revalidated by default: index.html so a deploy lands,
    # and sw.js above all — a cached service worker is a site that can
    # never update itself again.
    default       "no-cache";

    # Vite content-hashes these filenames, so a cached copy is immutable
    # by construction and this is what makes repeat loads instant.
    "~^/assets/"  "public, max-age=31536000, immutable";
}

server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;

    # sqlite3.wasm is ~856 kB uncompressed, ~393 kB gzipped.
    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_types        text/plain text/css application/javascript
                      application/json application/manifest+json
                      image/svg+xml application/wasm;

    # nginx 1.27 knows application/wasm, but WebAssembly streaming
    # instantiation rejects any other type, so be explicit.
    types {
        application/wasm            wasm;
        application/manifest+json   webmanifest;
    }
    include /etc/nginx/mime.types;

    add_header Cache-Control           $app_cache_control always;
    add_header X-Content-Type-Options  "nosniff"          always;
    add_header Referrer-Policy         "no-referrer"      always;
    add_header X-Frame-Options         "DENY"             always;
    add_header Permissions-Policy      "geolocation=(), camera=(), payment=(), interest-cohort=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" always;

    # No SPA rewrite: the app has no client-side router, so a 404 should
    # stay a 404 rather than become a 200 of HTML that the service worker
    # would then cache under an asset URL.
    location / {
        try_files $uri $uri/ =404;
    }
}
